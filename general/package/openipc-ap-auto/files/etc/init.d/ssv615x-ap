  #!/bin/sh

  SSID="OpenIPC-JA35"
  PASSPHRASE="12345678"
  INTERFACE="wlan0"
  IP_ADDR="192.168.10.1"
  NETMASK="255.255.255.0"
  DHCP_RANGE="192.168.10.100,192.168.10.200,255.255.255.0"

  case "$1" in
      start)
          # 加载驱动
          modprobe ssv6x5x 2>/dev/null || insmod /lib/modules/$(uname -r)/kernel/drivers/net/wireless/ssv/ssv6x5x.ko 2>/dev/null || true
          sleep 1
          
          # 配置接口
          ifconfig $INTERFACE $IP_ADDR netmask $NETMASK up 2>/dev/null || ip link set $INTERFACE up 2>/dev/null || true
          sleep 1
          
          # 启动 DHCP
          dnsmasq --interface=$INTERFACE --bind-interfaces --dhcp-range=$DHCP_RANGE --dhcp-leasefile=/tmp/dnsmasq.leases 2>/dev/null || true
          
          # 启动 AP
          hostapd -B /etc/hostapd.conf 2>/dev/null || true
          
          echo "AP started: SSID=$SSID, IP=$IP_ADDR"
          ;;
          
      stop)
          killall hostapd 2>/dev/null || true
          killall dnsmasq 2>/dev/null || true
          ifconfig $INTERFACE down 2>/dev/null || true
          ;;
          
      restart)
          $0 stop
          sleep 1
          $0 start
          ;;
          
      *)
          echo "Usage: $0 {start|stop|restart}"
          exit 1
          ;;
  esac

  exit 0
